{
  "uid": "taskflow-demo-red",
  "title": "My Demo RED",
  "description": "Практична №8, RED + Loki",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "TaskFlow",
    "Lab08",
    "RED"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"demo-app\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Requests / second"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx Error rate (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "100 * sum(rate(http_requests_total{job=\"demo-app\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"demo-app\"}[$__rate_interval])), 0.000001)",
          "refId": "A",
          "legendFormat": "5xx Error rate (%)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "taskflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "taskflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_ms_bucket{job=\"demo-app\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "Latency p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Service logs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "taskflow-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"demo-app\"}",
          "datasource": {
            "type": "loki",
            "uid": "taskflow-loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}