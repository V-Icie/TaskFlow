{
  "name": "taskflow-course-project",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow: практичні №1–8, REST, Docker, CI/CD та Observability",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/check-js-syntax.js",
    "check:lock": "node scripts/check-lock.js",
    "test:observability": "node --test tests/observability.test.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.13.3",
    "@opentelemetry/auto-instrumentations-node": "0.83.1"
  }
}
